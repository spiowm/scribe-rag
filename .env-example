# Єдиний .env на весь монорепозиторій. Скопіюй у .env і заповни.
#
# Звідси значення беруть:
#   * compose — підстановкою ${VAR} у docker-compose.yaml;
#   * бекенд на хості — через env_file у backend/dev.py;
#   * бот на хості — через uv run --env-file ../.env.
# У Coolify цього файлу немає: там ті самі ключі задаються в панелі,
# і compose підхоплює їх тією ж підстановкою.
#
# Усе, що не перелічено тут, має робочі дефолти в backend/src/config.py:
# хости сховищ, назви колекцій, модель agy, провайдер. Перекривай змінною
# середовища лише тоді, коли дефолт справді не підходить.

# --- секрети ---
NOTION_TOKEN=
GEMINI_API_KEY=
# base64 від JSON сервісного акаунта Google
GOOGLE_DRIVE_CREDENTIALS_JSON=
# Спільний секрет бота й бекенда: openssl rand -hex 32. Порожньо — без перевірки
INTERNAL_API_TOKEN=
# Робочі диски, що індексуються й вмикаються в /drives (id через кому)
GOOGLE_DRIVE_IDS=
# Загальний диск і сторонні джерела, доступні через його ярлики
GOOGLE_DRIVE_GENERAL_ID=
GOOGLE_DRIVE_GENERAL_FOREIGN=
# Необов'язкові політики груп доступу
GOOGLE_DRIVE_FULL_MEMBERS_GROUP=
GOOGLE_DRIVE_ADMIN_GROUP=
# Призупинені робочі диски (ID через кому). Не прибирайте їх з GOOGLE_DRIVE_IDS.
GOOGLE_DRIVE_PAUSED_IDS=
# Бази Notion, що індексуються таблицями: id[:властивість для поділу] через кому
NOTION_DATABASE_IDS=
MONGO_URI=
BOT_TOKEN=

# --- база ---
# Застосовується лише при створенні тому. Якщо том уже є, пароль мусить
# збігатися з тим, яким його створили, інакше бекенд не підʼєднається.
POSTGRES_PASSWORD=

# --- сховище мемів (Cloudflare R2) ---
# Бакет приватний, картинки віддаються через presigned GET.
# ACCOUNT_ID — це 32 hex-символи з адреси панелі, а не API-токен.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- адмінка ---
# Телеграм-id власника: йому йдуть сповіщення про відмови, і лише він бачить
# /admin. Один ключ на бота й бекенд. Порожній — адмінки й сповіщень немає.
ADMIN_TELEGRAM_ID=

# --- локальний запуск бота на хості ---
# У compose перебивається на http://backend:8000.
BACKEND_URL=http://localhost:8000

# Пароль локального кіраїнга всередині контейнера. Лишиш порожнім —
# ентрипойнт згенерує його сам і збереже в томі agy_home.
KEYRING_PW=


# --- публічний MCP (сервіс mcp у compose) ---
# Адреса, за якою сервер бачать ззовні, без / в кінці: з неї будуються issuer,
# .well-known і перенаправлення OAuth, тож вона мусить точно збігатися з доменом.
# На сервері — https://mcp.best-lviv.org.ua. На хості не потрібна: там дефолт
# PUBLIC_URL з config.py (http://localhost:8077).
MCP_PUBLIC_URL=http://localhost:8077

