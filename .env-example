# Єдиний .env на весь монорепозиторій. Скопіюй у .env і заповни.
#
# Звідси значення беруть:
#   * compose — підстановкою ${VAR} у docker-compose.yaml;
#   * бекенд на хості — через env_file у backend/dev.py;
#   * бот на хості — через uv run --env-file ../.env.
# У Coolify цього файлу немає: там ті самі ключі задаються в панелі,
# і compose підхоплює їх тією ж підстановкою.
#
# Усе, що не перелічено тут, має робочі дефолти в backend/src/config.py:
# хости сховищ, назви колекцій, модель agy, провайдер. Перекривай змінною
# середовища лише тоді, коли дефолт справді не підходить.

# --- секрети ---
NOTION_TOKEN=
GEMINI_API_KEY=
# base64 від JSON сервісного акаунта Google
GOOGLE_DRIVE_CREDENTIALS_JSON=
MONGO_URI=
BOT_TOKEN=

# --- база ---
# Застосовується лише при створенні тому. Якщо том уже є, пароль мусить
# збігатися з тим, яким його створили, інакше бекенд не підʼєднається.
POSTGRES_PASSWORD=

# --- локальний запуск бота на хості ---
# У compose перебивається на http://backend:8000.
BACKEND_URL=http://localhost:8000

# Пароль локального кіраїнга всередині контейнера. Лишиш порожнім —
# ентрипойнт згенерує його сам і збереже в томі agy_home.
KEYRING_PW=
