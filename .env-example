# Змінні для docker-compose (compose читає .env поряд із собою).
# Усе інше має дефолти — задавати не треба.

# Єдине обовʼязкове: пароль бази. Має збігатися з POSTGRES_PASSWORD
# у backend/.env, бо там цим паролем створюється база, а тут — зʼєднання.
POSTGRES_PASSWORD=

# POSTGRES_USER=postgres
# POSTGRES_DB=postgres

# Пароль локального кіраїнга в контейнері. Не заданий — ентрипойнт згенерує
# його сам і збереже в томі agy_home.
# KEYRING_PW=
