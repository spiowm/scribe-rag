# --- Обовʼязкові: без них бекенд не стартує ---

NOTION_TOKEN=
# base64 від JSON сервісного акаунта Google
GOOGLE_DRIVE_CREDENTIALS_JSON=
# Потрібен і для ембедингів, і як запасний шлях, коли agy недоступний
GEMINI_API_KEY=
MONGO_URI=

# Лише для запуску на хості: у compose пароль приходить із кореневого .env.
POSTGRES_PASSWORD=

# --- Далі все має робочі дефолти в src/config.py ---
# Розкоментуй лише те, що справді треба перекрити.

# Для запуску на хості; у compose їх перебиває сам compose.
# POSTGRES_HOST=localhost
# QDRANT_HOST=localhost

# agy — через підписку, gemini — платний API.
# LLM_PROVIDER=agy
# AGY_MODEL=gemini-3.7-flash-medium

# У контейнері шляхи задає Dockerfile.
# AGY_BIN=agy
# AGY_HOME=~/.agy-bot
# AGY_WORKDIR=~/.agy-bot-ws
